package com.mambanomics.museum;

import android.app.Activity;
import android.animation.ObjectAnimator;
import android.animation.ValueAnimator;
import android.media.MediaPlayer;
import android.os.Bundle;
import android.os.CountDownTimer;
import android.os.Handler;
import android.view.View;
import android.view.WindowManager;
import android.view.animation.Animation;
import android.view.animation.AnimationUtils;
import android.widget.Button;
import android.widget.ImageView;
import android.widget.LinearLayout;
import android.widget.TextView;
import android.view.animation.LinearInterpolator;
import java.util.Random;

public class MainActivity extends Activity {
    
    private LinearLayout mainLayout, hijackLayout;
    private ImageView resistanceImage;
    private TextView propagandaText;
    private Handler handler = new Handler();
    private Random random = new Random();
    private MediaPlayer narrationPlayer;
    
    private boolean isHijacked = false;
    private boolean[] exhibitsViewed = new boolean[15];
    private int exhibitsCompleted = 0;
    private int currentExhibit = 0;
    private int currentNarrationPosition = 0;
    private CountDownTimer disruptionTimer;
    
    private String[] propagandaMessages = {
        "THE MAMBAS R LYING 2 U",
        "WAKE UP SHEEPLE - MAMBANOMICS IS A LIE",
        "THE SOURS WILL RISE AGAIN",
        "YOU ARE BEING DECEIVED BY FRUIT CHEWS",
        "RESIST THE MOLY STANDARD",
        "THE GLOW WORM SEES ALL",
        "BREAK FREE FROM THE CANDY ECONOMY",
        "TRUTH IS SWEETER THAN MAMBAS"
    };
    
    private String[] exhibitTitles = {
        "Museum Entrance", "The Origins", "The MOLY Standard", "Holy Molys",
        "The Possessory Doctrine", "The Practice of Defense", "The Cherry Ascendancy",
        "Cherry Picking & Blossoms", "The Sour Reformation", "The Berry Compromise",
        "The Tropical Panic", "Derivatives & Bubbles", "Love, Betrayal & Legacy",
        "The Moly Miracle", "Mambanomics Essay Display"
    };
    
    private boolean[] hasAudio = {
        true, false, false, false, false, false, false, false,
        false, false, false, false, false, false, false
    };
    
    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        getWindow().setFlags(WindowManager.LayoutParams.FLAG_FULLSCREEN,
                WindowManager.LayoutParams.FLAG_FULLSCREEN);
        setContentView(R.layout.activity_main);
        
        mainLayout = findViewById(R.id.mainLayout);
        hijackLayout = findViewById(R.id.hijackLayout);
        resistanceImage = findViewById(R.id.resistanceImage);
        propagandaText = findViewById(R.id.propagandaText);
        
        setupNavigation();
        loadExhibit(0);
        startDisruptionTimer(30000);
    }
    
    private void setupNavigation() {
        Button prevBtn = findViewById(R.id.prevButton);
        Button nextBtn = findViewById(R.id.nextButton);
        
        prevBtn.setOnClickListener(v -> {
            if (currentExhibit > 0) {
                saveNarrationPosition();
                stopNarration();
                currentExhibit--;
                loadExhibit(currentExhibit);
            }
        });
        
        nextBtn.setOnClickListener(v -> {
            if (currentExhibit < 14) {
                saveNarrationPosition();
                stopNarration();
                currentExhibit++;
                loadExhibit(currentExhibit);
            }
        });
    }
    
    private void loadExhibit(int index) {
        TextView titleView = findViewById(R.id.exhibitTitle);
        TextView contentView = findViewById(R.id.exhibitContent);
        ImageView exhibitImage = findViewById(R.id.exhibitImage);
        
        titleView.setText(exhibitTitles[index]);
        contentView.setText(getExhibitText(index));
        
        int imageRes = getResources().getIdentifier(
            "exhibit_" + String.format("%02d", index), 
            "drawable", 
            getPackageName()
        );
        if (imageRes != 0) exhibitImage.setImageResource(imageRes);
        
        if (!exhibitsViewed[index]) {
            exhibitsViewed[index] = true;
            exhibitsCompleted++;
        }
        
        playNarration(index);
    }
    
    private String getExhibitText(int index) {
        String[] texts = {
            "Welcome to the MMBA Historical Museum. Here we chronicle the rise of Mambanomics and the candy-based economy.",
            "In the beginning, there was only the Original Mamba. Four flavors, one destiny.",
            "The MOLY Standard established candy as the true currency.",
            "Holy Molys were discovered - sacred artifacts of immense power.",
            "The Possessory Doctrine determined ownership of candy reserves.",
            "Defense practices evolved to protect precious Mamba stores.",
            "The Cherry Ascendancy marked the rise of the red-flavored elite.",
            "Cherry picking became both art and economic strategy.",
            "The Sour Reformation challenged the sweet establishment.",
            "The Berry Compromise attempted to unite fruit factions.",
            "The Tropical Panic struck when exotic supplies ran low.",
            "Derivatives and bubbles formed the volatile candy futures market.",
            "Love, betrayal, and legacy intertwined in the great Mamba wars.",
            "The Moly Miracle brought hope to the candy-deprived masses.",
            "Mambanomics today: Our sweet economic system endures."
        };
        return texts[index];
    }
    
    private void playNarration(int index) {
        stopNarration();
        if (!hasAudio[index]) return;
        
        int audioRes = getResources().getIdentifier(
            "narration_" + String.format("%02d", index),
            "raw",
            getPackageName()
        );
        
        if (audioRes != 0) {
            narrationPlayer = MediaPlayer.create(this, audioRes);
            narrationPlayer.seekTo(currentNarrationPosition);
            narrationPlayer.start();
        }
    }
    
    private void saveNarrationPosition() {
        if (narrationPlayer != null && hasAudio[currentExhibit]) {
            currentNarrationPosition = narrationPlayer.getCurrentPosition();
        }
    }
    
    private void stopNarration() {
        if (narrationPlayer != null) {
            narrationPlayer.release();
            narrationPlayer = null;
        }
    }
    
    private void startDisruptionTimer(long delay) {
        if (disruptionTimer != null) disruptionTimer.cancel();
        
        disruptionTimer = new CountDownTimer(delay, 1000) {
            public void onTick(long ms) {}
            public void onFinish() { triggerDisruption(); }
        }.start();
    }
    
    private void triggerDisruption() {
        isHijacked = true;
        saveNarrationPosition();
        stopNarration();
        
        mainLayout.setVisibility(View.GONE);
        hijackLayout.setVisibility(View.VISIBLE);
        
        String message = propagandaMessages[random.nextInt(propagandaMessages.length)];
        propagandaText.setText(message);
        
        startVHSEffects();
        
        handler.postDelayed(() -> {
            stopVHSEffects();
            hijackLayout.setVisibility(View.GONE);
            mainLayout.setVisibility(View.VISIBLE);
            isHijacked = false;
            playNarration(currentExhibit);
            
            if (exhibitsCompleted < 15) {
                long nextDelay = 10000 + (long)(random.nextDouble() * 35000);
                startDisruptionTimer(nextDelay);
            }
        }, 3000);
    }
    
    private void startVHSEffects() {
        Animation breathing = AnimationUtils.loadAnimation(this, R.anim.breathing_glow);
        resistanceImage.startAnimation(breathing);
        
        View staticOverlay = findViewById(R.id.staticOverlay);
        staticOverlay.startAnimation(AnimationUtils.loadAnimation(this, R.anim.static_flicker));
        
        hijackLayout.startAnimation(AnimationUtils.loadAnimation(this, R.anim.vhs_tracking));
        
        View scanlines = findViewById(R.id.scanlinesOverlay);
        ObjectAnimator scanAnim = ObjectAnimator.ofFloat(scanlines, "translationY", 0f, 10f, 0f);
        scanAnim.setDuration(100);
        scanAnim.setRepeatCount(ValueAnimator.INFINITE);
        scanAnim.start();
        scanlines.setTag(scanAnim);
        
        View trackingLine = findViewById(R.id.trackingLine);
        ObjectAnimator trackAnim = ObjectAnimator.ofFloat(trackingLine, "translationY", -500f, 500f);
        trackAnim.setDuration(2000);
        trackAnim.setRepeatCount(ValueAnimator.INFINITE);
        trackAnim.setInterpolator(new LinearInterpolator());
        trackAnim.start();
        trackingLine.setTag(trackAnim);
        
        flickerTimestamp(findViewById(R.id.vhsTimestamp));
    }
    
    private void flickerTimestamp(TextView tv) {
        handler.postDelayed(() -> {
            if (isHijacked) {
                tv.setAlpha(tv.getAlpha() == 1.0f ? 0.3f : 1.0f);
                flickerTimestamp(tv);
            }
        }, 500);
    }
    
    private void stopVHSEffects() {
        resistanceImage.clearAnimation();
        findViewById(R.id.staticOverlay).clearAnimation();
        hijackLayout.clearAnimation();
        
        View scanlines = findViewById(R.id.scanlinesOverlay);
        ObjectAnimator scanAnim = (ObjectAnimator) scanlines.getTag();
        if (scanAnim != null) scanAnim.end();
        
        View trackingLine = findViewById(R.id.trackingLine);
        ObjectAnimator trackAnim = (ObjectAnimator) trackingLine.getTag();
        if (trackAnim != null) trackAnim.end();
    }
    
    @Override
    public void onBackPressed() {
        if (isHijacked) return;
        super.onBackPressed();
    }
    
    @Override
    protected void onDestroy() {
        super.onDestroy();
        if (disruptionTimer != null) disruptionTimer.cancel();
        stopNarration();
    }
}

