                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="4dp"
                android:layout_marginLeft="4dp">
                
                <TextView
                    android:id="@+id/exhibitTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:textColor="#000000"/>
                
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:id="@+id/exhibitContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textColor="#000000"/>
                </ScrollView>
            </LinearLayout>
        </LinearLayout>
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#C0C0C0"
            android:padding="4dp">
            
            <Button
                android:id="@+id/prevButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&lt;&lt; PREV"
                android:background="@drawable/win95_button"
                android:textColor="#000000"
                android:textSize="12sp"/>
            
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            
            <Button
                android:id="@+id/nextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEXT &gt;&gt;"
                android:background="@drawable/win95_button"
                android:textColor="#000000"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>
    
    <FrameLayout
        android:id="@+id/hijackLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">
        
        <ImageView
            android:id="@+id/resistanceImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:padding="40dp"/>
        
        <View
            android:id="@+id/scanlinesOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/vhs_scanlines"
            android:alpha="0.4"/>
        
        <View
            android:id="@+id/staticOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:alpha="0.15"/>
        
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/vhs_grime"/>
        
        <TextView
            android:id="@+id/propagandaText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|bottom"
            android:layout_marginBottom="80dp"
            android:textColor="#00FF00"
            android:textSize="16sp"
